<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================== -->
    <!-- KODA MATE - Dark Blue Theme Color Palette     -->
    <!-- ============================================== -->

    <!-- Primary Background Colors -->
    <Color x:Key="PrimaryBackground">#0B0E14</Color>
    <Color x:Key="SecondaryBackground">#131820</Color>
    <Color x:Key="TertiaryBackground">#1A202C</Color>
    <Color x:Key="CardBackground">#161B24</Color>
    <Color x:Key="SurfaceBackground">#1E2530</Color>

    <!-- Gradient Colors (Cyan to Deep Blue) -->
    <Color x:Key="GradientStart">#00E5FF</Color>
    <Color x:Key="GradientMiddle">#00B4D8</Color>
    <Color x:Key="GradientEnd">#2979FF</Color>
    <Color x:Key="GradientDeep">#1565C0</Color>

    <!-- Accent Colors -->
    <Color x:Key="AccentCyan">#00E5FF</Color>
    <Color x:Key="AccentBlue">#2979FF</Color>
    <Color x:Key="AccentPurple">#7C4DFF</Color>
    <Color x:Key="AccentGreen">#00E676</Color>
    <Color x:Key="AccentOrange">#FF9800</Color>
    <Color x:Key="AccentRed">#FF5252</Color>
    <Color x:Key="AccentPink">#E91E63</Color>

    <!-- Status Colors -->
    <Color x:Key="StatusSuccess">#00E676</Color>
    <Color x:Key="StatusWarning">#FF9800</Color>
    <Color x:Key="StatusError">#FF5252</Color>
    <Color x:Key="StatusInfo">#00B4D8</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#B0BEC5</Color>
    <Color x:Key="TextTertiary">#78909C</Color>
    <Color x:Key="TextDisabled">#546E7A</Color>
    <Color x:Key="TextOnGradient">#FFFFFF</Color>

    <!-- Legacy Color Keys (for compatibility) -->
    <Color x:Key="Primary">#2979FF</Color>
    <Color x:Key="PrimaryDark">#00E5FF</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#00B4D8</Color>
    <Color x:Key="SecondaryDarkText">#B0BEC5</Color>
    <Color x:Key="Tertiary">#7C4DFF</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="OffBlack">#0B0E14</Color>

    <!-- Gray Scale -->
    <Color x:Key="Gray100">#F5F5F5</Color>
    <Color x:Key="Gray200">#EEEEEE</Color>
    <Color x:Key="Gray300">#B0BEC5</Color>
    <Color x:Key="Gray400">#90A4AE</Color>
    <Color x:Key="Gray500">#78909C</Color>
    <Color x:Key="Gray600">#546E7A</Color>
    <Color x:Key="Gray700">#37474F</Color>
    <Color x:Key="Gray800">#263238</Color>
    <Color x:Key="Gray900">#1A202C</Color>
    <Color x:Key="Gray950">#0B0E14</Color>

    <!-- ============================================== -->
    <!-- Gradient Brushes                               -->
    <!-- ============================================== -->
    
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource GradientStart}" Offset="0.0"/>
        <GradientStop Color="{StaticResource GradientEnd}" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VerticalGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource GradientStart}" Offset="0.0"/>
        <GradientStop Color="{StaticResource GradientEnd}" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HorizontalGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource GradientStart}" Offset="0.0"/>
        <GradientStop Color="{StaticResource GradientMiddle}" Offset="0.5"/>
        <GradientStop Color="{StaticResource GradientEnd}" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PowerButtonGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource GradientStart}" Offset="0.0"/>
        <GradientStop Color="{StaticResource GradientEnd}" Offset="0.7"/>
        <GradientStop Color="{StaticResource GradientDeep}" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource GradientStart}" Offset="0.0"/>
        <GradientStop Color="{StaticResource GradientEnd}" Offset="1.0"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="GlowGradientBrush" Center="0.5,0.5" Radius="0.5">
        <GradientStop Color="#4000E5FF" Offset="0.0"/>
        <GradientStop Color="#2000E5FF" Offset="0.5"/>
        <GradientStop Color="#00000000" Offset="1.0"/>
    </RadialGradientBrush>

    <!-- ============================================== -->
    <!-- Solid Color Brushes                            -->
    <!-- ============================================== -->
    
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackground}"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackground}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}"/>
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="{StaticResource SurfaceBackground}"/>

    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyan}"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreen}"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRed}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}"/>

    <!-- Legacy Brushes (for compatibility) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

</ResourceDictionary>