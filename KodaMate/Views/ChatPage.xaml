<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KodaMate.ViewModels"
             xmlns:models="clr-namespace:KodaMate.Models"
             x:Class="KodaMate.Views.ChatPage"
             x:DataType="viewmodels:ChatViewModel"
             Title="Chat"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" 
          BackgroundColor="{StaticResource PrimaryBackground}">
        
        <!-- ============================================== -->
        <!-- HEADER                                         -->
        <!-- ============================================== -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource SecondaryBackground}"
                StrokeThickness="0"
                Padding="20,50,20,15">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,20,20"/>
            </Border.StrokeShape>
            
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                <Image Source="koda_logo.png"
                       HeightRequest="48"
                       WidthRequest="48"
                       Aspect="AspectFit"
                       VerticalOptions="Center"/>
                
                <VerticalStackLayout Grid.Column="1" 
                                     VerticalOptions="Center"
                                     Margin="4,0,0,0">
                    <Label Text="Koda AI"
                           Style="{StaticResource Headline}"
                           TextColor="{StaticResource TextPrimary}"/>
                    <HorizontalStackLayout Spacing="6">
                        <Ellipse Fill="{StaticResource AccentGreen}"
                                 WidthRequest="8"
                                 HeightRequest="8"
                                 VerticalOptions="Center"/>
                        <Label Text="En ligne — propulsé par n8n"
                               Style="{StaticResource Caption1}"
                               TextColor="{StaticResource AccentGreen}"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <Border Grid.Column="2"
                        BackgroundColor="{Binding WifiIndicatorColor}"
                        StrokeShape="RoundRectangle 22"
                        Stroke="Transparent"
                        WidthRequest="40"
                        HeightRequest="40"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenWifiNetworksCommand}"/>
                    </Border.GestureRecognizers>
                    <Image Source="wifi.png"
                           HeightRequest="20"
                           WidthRequest="20"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <!-- Clear Button -->
                <Border Grid.Column="3"
                        BackgroundColor="{StaticResource SurfaceBackground}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="Transparent"
                        WidthRequest="40"
                        HeightRequest="40">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ClearConversationCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="🗑️"
                           FontSize="18"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- CHAT MESSAGES                                  -->
        <!-- ============================================== -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Messages}"
                        Margin="0,10,0,0"
                        ItemsUpdatingScrollMode="KeepLastItemInView">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatMessage">
                    <Grid Padding="16,6">
                        <!-- User Message (Right aligned, gradient blue) -->
                        <Border IsVisible="{Binding IsUserMessage}"
                                HorizontalOptions="End"
                                MaximumWidthRequest="280"
                                Padding="16,12"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 20,20,4,20">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource GradientStart}" Offset="0.0"/>
                                    <GradientStop Color="{StaticResource GradientEnd}" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <VerticalStackLayout Spacing="4">
                                <Image Source="{Binding ImagePath}"
                                       IsVisible="{Binding ImagePath, Converter={StaticResource StringToBoolConverter}}"
                                       HeightRequest="160"
                                       Aspect="AspectFit"/>
                                <Label Text="{Binding Content}"
                                       TextColor="{StaticResource White}"
                                       FontSize="15"
                                       LineBreakMode="WordWrap"/>
                                <Label Text="{Binding Timestamp, StringFormat='{0:HH:mm}'}"
                                       TextColor="{StaticResource White}"
                                       FontSize="10"
                                       Opacity="0.7"
                                       HorizontalOptions="End"/>
                            </VerticalStackLayout>
                        </Border>
                        
                        <!-- Koda Message (Left aligned, dark gray) -->
                        <Border IsVisible="{Binding IsUserMessage, Converter={StaticResource InvertedBoolConverter}}"
                                HorizontalOptions="Start"
                                MaximumWidthRequest="280"
                                BackgroundColor="{StaticResource CardBackground}"
                                Padding="16,12"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 20,20,20,4">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Content}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="15"
                                       LineBreakMode="WordWrap"/>
                                <Label Text="{Binding Timestamp, StringFormat='{0:HH:mm}'}"
                                       TextColor="{StaticResource TextTertiary}"
                                       FontSize="10"
                                       HorizontalOptions="End"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        
        <!-- Typing Indicator -->
        <HorizontalStackLayout Grid.Row="1"
                               IsVisible="{Binding IsTyping}"
                               VerticalOptions="End"
                               Padding="20,10"
                               Spacing="8">
            <Border BackgroundColor="{StaticResource CardBackground}"
                    Padding="16,12"
                    StrokeShape="RoundRectangle 16"
                    Stroke="Transparent">
                <HorizontalStackLayout Spacing="6">
                    <Ellipse Fill="{StaticResource TextTertiary}"
                             WidthRequest="8"
                             HeightRequest="8"/>
                    <Ellipse Fill="{StaticResource TextSecondary}"
                             WidthRequest="8"
                             HeightRequest="8"/>
                    <Ellipse Fill="{StaticResource AccentCyan}"
                             WidthRequest="8"
                             HeightRequest="8"/>
                </HorizontalStackLayout>
            </Border>
            <Label Text="Koda réfléchit..."
                   Style="{StaticResource Caption1}"
                   VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <!-- ============================================== -->
        <!-- INPUT AREA                                     -->
        <!-- ============================================== -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource SecondaryBackground}"
                Padding="16,12,16,30"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 20,20,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                
                <!-- Camera Button -->
                <Border BackgroundColor="{StaticResource SurfaceBackground}"
                        StrokeShape="RoundRectangle 22"
                        Stroke="Transparent"
                        WidthRequest="44"
                        HeightRequest="44">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TakePhotoCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="📷"
                           FontSize="20"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
                
                <!-- Text Input -->
                <Border Grid.Column="1"
                        BackgroundColor="{StaticResource SurfaceBackground}"
                        StrokeShape="RoundRectangle 22"
                        Stroke="Transparent"
                        Padding="16,0">
                    <Entry Placeholder="Écrivez un message à Koda..."
                           PlaceholderColor="{StaticResource TextTertiary}"
                           TextColor="{StaticResource TextPrimary}"
                           BackgroundColor="Transparent"
                           Text="{Binding MessageText}"
                           ReturnCommand="{Binding SendMessageCommand}"
                           FontSize="15"
                           VerticalOptions="Center"/>
                </Border>
                
                <!-- Send Button -->
                <Border Grid.Column="2"
                        WidthRequest="44"
                        HeightRequest="44"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 22">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource GradientStart}" Offset="0.0"/>
                            <GradientStop Color="{StaticResource GradientEnd}" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SendMessageCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="➤"
                           FontSize="20"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
