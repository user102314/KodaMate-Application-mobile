<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:KodaMate"
             xmlns:converters="clr-namespace:KodaMate.Converters"
             x:Class="KodaMate.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- ============================================== -->
            <!-- Global Value Converters                        -->
            <!-- ============================================== -->
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <converters:IntToProgressConverter x:Key="IntToProgressConverter"/>
            <converters:BoolToGradientStartConverter x:Key="BoolToGradientStartConverter"/>
            <converters:BoolToGradientEndConverter x:Key="BoolToGradientEndConverter"/>
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
            <converters:BoolToPowerTextConverter x:Key="BoolToPowerTextConverter"/>
            <converters:BoolToStatusTextConverter x:Key="BoolToStatusTextConverter"/>
            <converters:IntToBoolConverter x:Key="IntToBoolConverter"/>
            <converters:BoolToFontFamilyConverter x:Key="BoolToFontFamilyConverter"/>
            <converters:TabIndexToColorConverter x:Key="TabIndexToColorConverter"/>
            <converters:BoolToTextDecorationConverter x:Key="BoolToTextDecorationConverter"/>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
